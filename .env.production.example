# À copier en .env à côté de compose.prod.yaml, sur le VPS seulement.

# Sous-domaine DuckDNS pointé sur le VPS, sans https://.
DOMAIN=
# Adresse prévenue par Let's Encrypt avant l'expiration d'un certificat.
ACME_EMAIL=

# Hexadécimal seulement (openssl rand -hex 32) : le mot de passe est placé tel quel dans l'URL de connexion.
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=

# Facultatifs : vides, la génération par IA et le paiement répondent 503.
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
