# Copier en `.env.local` (ignoré par git), lu par le backend sous Docker (compose.yaml).
# Après chaque modification : `docker compose up -d backend` (un redémarrage ne relit pas ce fichier).

# Compte admin local, créé ou remis à niveau à chaque démarrage (jamais en production).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe, en mode test (sk_test_…). Sans les quatre, le paiement répond 503.
# Clé secrète : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secret affiché par `stripe listen --forward-to localhost:8080/api/v1/billing/webhook`.
STRIPE_WEBHOOK_SECRET=
# Identifiants des deux prix récurrents du produit Premium (price_…).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Front où Stripe renvoie après le paiement ou le portail.
FRONTEND_URL=http://localhost:3000
