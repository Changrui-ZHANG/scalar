# Adresse du backend pour le rendu serveur et le pont de développement
# (le navigateur, lui, passe par NUXT_PUBLIC_API_BASE). Le pont garde
# l'en-tête Host (jamais changeOrigin).
# Lue dans runtimeConfig.apiInternalBase.
NUXT_API_INTERNAL_BASE=http://127.0.0.1:3001/api/v1

# Chemin de l'API vu par le navigateur : toujours un chemin, jamais un hôte.
NUXT_PUBLIC_API_BASE=/api/v1

# Port du serveur de développement.
PORT=3000

# Adresse publique du site (URL canonique, sitemap, robots.txt).
NUXT_SITE_URL=http://127.0.0.1:8080

# production = indexable ; toute autre valeur = robots « noindex » partout.
NUXT_SITE_ENV=development
