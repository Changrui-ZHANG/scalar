# Adresse du backend pour le pont de développement de Nuxt (le backoffice
# n'a pas de rendu serveur : le navigateur passe par NUXT_PUBLIC_API_BASE).
# Le pont garde l'en-tête Host (jamais changeOrigin) : le contrôle d'Origin
# de l'API d'administration en dépend. Lue dans runtimeConfig.apiInternalBase.
NUXT_API_INTERNAL_BASE=http://127.0.0.1:3001/api/v1

# Chemin de l'API vu par le navigateur : toujours un chemin, jamais un hôte.
NUXT_PUBLIC_API_BASE=/api/v1

# Port du serveur de développement.
PORT=3002
