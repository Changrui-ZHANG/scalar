generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Contraintes que Prisma ne sait pas exprimer, ecrites a la main a la fin des
// migrations `*_init` (positions uniques a controle differe, controles CHECK du
// contenu), `*_learner_tables` (controles CHECK des tables apprenant),
// `*_questionnaire_tables` (positions uniques et controles CHECK du questionnaire)
// et `*_placement_table` (controles CHECK des resultats du questionnaire).

/// Ou en est la publication d'un contenu : seul `published` est servi.
enum PublicationStatus {
  draft
  published
  archived

  @@map("publication_status")
}

/// Niveau d'un chapitre ; l'ordre des valeurs est l'ordre d'affichage.
enum ChapterLevel {
  beginner
  intermediate
  advanced
  ecosystem

  @@map("chapter_level")
}

/// Langage des exercices d'un parcours. Le backend sait comment l'executer.
enum ProgrammingLanguage {
  javascript
  typescript

  @@map("programming_language")
}

/// Resultat du dernier passage de la solution d'un exercice dans ses cas de test.
enum SolutionCheckStatus {
  not_checked
  passed
  failed

  @@map("solution_check_status")
}

/// Un parcours du site : JavaScript, TypeScript, Conception...
model Track {
  id                  Int                  @id @default(autoincrement())
  slug                String               @unique
  name                String
  /// Une phrase affichee sur la page Parcours.
  summary             String
  /// Ordre sur la page Parcours, a partir de 1.
  position            Int
  /// Nul pour un parcours de lecons seulement : ses chapitres n'ont pas d'exercice.
  programmingLanguage ProgrammingLanguage? @map("programming_language")
  prerequisiteTrackId Int?                 @map("prerequisite_track_id")
  prerequisiteTrack   Track?               @relation("TrackPrerequisite", fields: [prerequisiteTrackId], references: [id], onDelete: SetNull)
  dependentTracks     Track[]              @relation("TrackPrerequisite")
  status              PublicationStatus    @default(draft)
  /// Rempli a la premiere publication : verrouille le slug, interdit la suppression.
  firstPublishedAt    DateTime?            @map("first_published_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  chapters            Chapter[]
  certificates        Certificate[]
  placements          Placement[]

  @@map("tracks")
}

model Chapter {
  id               Int               @id @default(autoincrement())
  trackId          Int               @map("track_id")
  track            Track             @relation(fields: [trackId], references: [id], onDelete: Restrict)
  slug             String
  level            ChapterLevel
  /// Ordre dans le niveau, a partir de 1.
  position         Int
  title            String
  summary          String
  status           PublicationStatus @default(draft)
  firstPublishedAt DateTime?         @map("first_published_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  lessons          Lesson[]
  exercises        Exercise[]

  @@unique([trackId, slug], name: "chapters_track_slug_key")
  @@map("chapters")
}

model Lesson {
  id               Int               @id @default(autoincrement())
  chapterId        Int               @map("chapter_id")
  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  slug             String
  /// Ordre dans le chapitre, a partir de 1.
  position         Int
  title            String
  /// Une phrase, affichee dans les listes.
  summary          String
  /// Le cours, en Markdown.
  body             String
  /// Un cours vieillit vite : date de sa derniere relecture.
  lastReviewedAt   DateTime?         @map("last_reviewed_at") @db.Timestamptz(6)
  status           PublicationStatus @default(draft)
  firstPublishedAt DateTime?         @map("first_published_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([chapterId, slug], name: "lessons_chapter_slug_key")
  @@map("lessons")
}

model Exercise {
  id                  Int                 @id @default(autoincrement())
  chapterId           Int                 @map("chapter_id")
  chapter             Chapter             @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  slug                String
  /// Ordre dans le chapitre, a partir de 1.
  position            Int
  title               String
  /// La consigne, en Markdown.
  instructions        String
  /// Fonction que l'apprenant doit ecrire, et que les cas de test appellent.
  functionName        String              @map("function_name")
  starterCode         String              @map("starter_code")
  /// Jamais renvoyee au navigateur avant une premiere soumission.
  solutionCode        String              @map("solution_code")
  /// Du plus vague au plus precis, trois au plus.
  hints               String[]            @default([])
  /// Remis a `not_checked` des que le code ou un cas de test change.
  solutionCheckStatus SolutionCheckStatus @default(not_checked) @map("solution_check_status")
  solutionCheckedAt   DateTime?           @map("solution_checked_at") @db.Timestamptz(6)
  status              PublicationStatus   @default(draft)
  firstPublishedAt    DateTime?           @map("first_published_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  testCases           ExerciseTestCase[]
  progress            ExerciseProgress[]

  @@unique([chapterId, slug], name: "exercises_chapter_slug_key")
  @@map("exercises")
}

model ExerciseTestCase {
  id             Int      @id @default(autoincrement())
  exerciseId     Int      @map("exercise_id")
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// Ordre d'affichage, a partir de 1.
  position       Int
  /// Arguments passes a la fonction : toujours un tableau JSON.
  arguments      Json
  expectedResult Json     @map("expected_result")
  /// Cache a l'apprenant, pour qu'il ne puisse pas recopier les reponses.
  isHidden       Boolean  @default(false) @map("is_hidden")
  /// Facultatif : « tableau vide », « nombres negatifs ».
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("exercise_test_cases")
}

/// Un apprenant inscrit : email et mot de passe.
model User {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Toujours en minuscules (controle CHECK) : l'unicite ne depend pas de la casse.
  email        String             @unique
  /// Hash argon2, jamais le mot de passe.
  passwordHash String             @map("password_hash")
  /// Incremente pour revoquer tous les JWT deja emis (deconnexion, mot de passe change).
  tokenVersion Int                @default(0) @map("token_version")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  progress     ExerciseProgress[]
  certificates Certificate[]
  placements   Placement[]

  @@map("users")
}

/// Ou en est un apprenant sur un exercice ; la ligne nait a sa premiere soumission.
model ExerciseProgress {
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId    Int       @map("exercise_id")
  exercise      Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// Nombre de verifications soumises, au moins 1.
  attempts      Int
  /// Rempli a la premiere reussite, jamais efface : un exercice reussi le reste.
  firstPassedAt DateTime? @map("first_passed_at") @db.Timestamptz(6)
  lastAttemptAt DateTime  @map("last_attempt_at") @db.Timestamptz(6)

  @@id([userId, exerciseId])
  @@index([exerciseId])
  @@map("exercise_progress")
}

/// Delivre sur demande, une fois tous les exercices publies du parcours reussis.
model Certificate {
  id         Int      @id @default(autoincrement())
  /// Identifiant public, dans l'URL de verification.
  code       String   @unique
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId    Int      @map("track_id")
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  /// Nom affiche sur le certificat, fige a sa delivrance.
  holderName String   @map("holder_name")
  issuedAt   DateTime @map("issued_at") @db.Timestamptz(6)

  @@unique([userId, trackId], name: "certificates_user_track_key")
  @@index([trackId])
  @@map("certificates")
}

/// Famille d'une question du questionnaire de positionnement.
enum QuestionnaireQuestionKind {
  experience
  language
  knowledge
  code

  @@map("questionnaire_question_kind")
}

/// Une question du questionnaire de positionnement.
model QuestionnaireQuestion {
  id           Int                       @id @default(autoincrement())
  /// Ordre dans le questionnaire, a partir de 1.
  position     Int
  kind         QuestionnaireQuestionKind
  title        String
  /// En Markdown.
  description  String?
  /// Poids dans sa famille (connaissances, exercices) : la difficulte compte plus.
  weight       Int                       @default(1)
  /// Les trois champs de code ne sont remplis que pour `code`.
  functionName String?                   @map("function_name")
  starterCode  String?                   @map("starter_code")
  /// Jamais renvoyee au navigateur.
  solutionCode String?                   @map("solution_code")
  status       PublicationStatus         @default(draft)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  options      QuestionnaireOption[]
  testCases    QuestionnaireTestCase[]

  @@map("question")
}

/// Un choix d'une question a choix (experience, langage, connaissances).
model QuestionnaireOption {
  id         Int                   @id @default(autoincrement())
  questionId Int                   @map("question")
  question   QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Ordre dans la question, a partir de 1.
  position   Int
  label      String
  /// Entre 0 et 1. Jamais renvoye au navigateur : il donnerait la bonne reponse.
  score      Float
  /// Parcours propose par une option de la question de langage.
  trackSlug  String?               @map("track_slug")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("option")
}

model QuestionnaireTestCase {
  id             Int                   @id @default(autoincrement())
  questionId     Int                   @map("question")
  question       QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Ordre d'affichage, a partir de 1.
  position       Int
  /// Arguments passes a la fonction : toujours un tableau JSON.
  arguments      Json
  expectedResult Json                  @map("expected_result")
  isHidden       Boolean               @default(false) @map("is_hidden")
  description    String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("testCase")
}

/// Resultat d'un questionnaire de positionnement ; anonyme tant qu'aucun compte ne le reprend.
model Placement {
  id        Int          @id @default(autoincrement())
  /// Sur 100.
  score     Int
  /// Jamais `ecosystem` (controle CHECK) : le questionnaire ne place pas si loin.
  level     ChapterLevel
  /// Parcours conseille.
  trackId   Int          @map("track")
  track     Track        @relation(fields: [trackId], references: [id], onDelete: Restrict)
  /// Sous-scores entre 0 et 1 : auto-evaluation, connaissances, exercices.
  declared  Float
  knowledge Float
  practical Float
  userId    String?      @map("user") @db.Uuid
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([trackId])
  @@index([userId])
  @@map("placement")
}
