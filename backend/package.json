{
  "name": "backend",
  "version": "0.0.0",
  "description": "API Scalar",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit && npm run verify:runtime",
    "test": "vitest run",
    "verify:runtime": "node --input-type=module -e \"await import('./src/app.ts'); await import('./src/models/index.ts'); await import('./src/config/index-requis.ts'); await import('./src/services/base-donnees.service.ts'); await import('./src/commands/creer-index.ts')\"",
    "db:index": "node --env-file-if-exists=.env src/commands/creer-index.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
