{
  "name": "backend",
  "version": "0.0.0",
  "description": "API Scalar",
  "main": "src/main.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "vite",
    "start": "node src/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . ../tests/backend",
    "lint:fix": "eslint . ../tests/backend --fix",
    "format": "prettier --write . ../tests/backend",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node src/database/seed.cli.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@scalar/shared": "*",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.12.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vite-plugin-node": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
