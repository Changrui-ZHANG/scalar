# Configuration locale du backend
# Port d'écoute de l'API.
PORT=3001

# Base de développement (PostgreSQL du compose, port 5433 sur l'hôte).
DATABASE_URL=postgres://scalar:scalar@localhost:5433/scalar

# Base des tests (vidée par eux) ; défaut : celle-ci.
DATABASE_URL_TEST=postgres://scalar:scalar@localhost:5433/scalar_test

# Source du contenu public : database, ou mock (données du dépôt, sans PostgreSQL).
CONTENT_SOURCE=database

# Piston du compose, port 2000 sur l'hôte.
PISTON_URL=http://127.0.0.1:2000/api/v2

# Version de Node installée dans Piston : doit être exactement celle-ci.
PISTON_NODE_VERSION=20.11.1

# Prévue, pas encore lue par le code : monterait /api/v1/admin (jamais true sur un serveur public avant l'authentification).
# ADMIN_API_ENABLED=true

# Niveau du journal : debug, info, warn, error.
LOG_LEVEL=debug

# Charge le contenu du dépôt si la base n'a aucun parcours (jamais en production).
SEED_ON_EMPTY=true

# Exécutions et vérifications autorisées par minute et par adresse IP (budget commun), au-delà : 429.
EXECUTION_RATE_LIMIT=30

# Nombre de reverse proxys devant l'API : 0 en accès direct, 1 derrière Traefik (compose).
TRUST_PROXY_HOPS=0

# Prévue, pas encore lue par le code : événements de statistiques autorisés par minute et par adresse IP.
# EVENT_RATE_LIMIT=120
