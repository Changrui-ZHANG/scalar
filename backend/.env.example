# Configuration locale du backend
# Port d'écoute de l'API.
PORT=3001

# Base de développement (PostgreSQL du compose, port 5433 sur l'hôte).
DATABASE_URL=postgres://scalar:scalar@localhost:5433/scalar

# Base des tests (vidée par eux) ; défaut : celle-ci.
DATABASE_URL_TEST=postgres://scalar:scalar@localhost:5433/scalar_test

# Source du contenu public : database, ou mock (données du dépôt, sans PostgreSQL).
CONTENT_SOURCE=database

# Piston du compose, port 2000 sur l'hôte.
PISTON_URL=http://127.0.0.1:2000/api/v2

# Version de Node installée dans Piston : doit être exactement celle-ci.
PISTON_NODE_VERSION=20.11.1

# Niveau du journal : debug, info, warn, error.
LOG_LEVEL=debug

# Charge le contenu du dépôt si la base n'a aucun parcours (jamais en production).
SEED_ON_EMPTY=true

# Exécutions et vérifications autorisées par minute et par adresse IP, toutes routes confondues (429 au-delà).
EXECUTION_RATE_LIMIT=30

# Apprenants anonymes créés par minute et par adresse IP (429 au-delà) : chacun est une ligne en base.
LEARNER_CREATION_RATE_LIMIT=10

# Secret de signature des jetons de session (32 caractères au moins), obligatoire.
# En générer un : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-un-secret-aleatoire-de-32-caracteres-ou-plus

# Compte admin local, créé ou remis à niveau à chaque démarrage (jamais en production).
# Sous Docker, à mettre dans `.env.local` à la racine du dépôt.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Cookie de session marqué Secure (HTTPS seulement) ; défaut : true. false ici pour un site servi
# en http : certains clients (dont le client REST de VS Code) n'y renverraient pas un cookie Secure.
AUTH_COOKIE_SECURE=false

# Connexions et inscriptions ratées sur 15 minutes (429 au-delà) : par IP et email, par IP,
# par email (ce dernier contre une attaque depuis de nombreuses IP).
AUTH_ATTEMPTS_LIMIT=10
AUTH_IP_ATTEMPTS_LIMIT=30
AUTH_ACCOUNT_ATTEMPTS_LIMIT=20
