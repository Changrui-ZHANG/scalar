# Configuration locale du backend
# Port d'écoute de l'API.
PORT=3001

# Base de développement (PostgreSQL du compose, port 5433 sur l'hôte).
DATABASE_URL=postgres://scalar:scalar@localhost:5433/scalar

# Base des tests d'intégration (*.db.test.ts) ; vide = tests ignorés.
DATABASE_URL_TEST=postgres://scalar:scalar@localhost:5433/scalar_test

# Source du contenu public : database, ou mock (données du dépôt, sans PostgreSQL).
CONTENT_SOURCE=database

# Adaptateur du moteur d'exécution : piston (seule valeur pour l'instant).
EXECUTION_ENGINE=piston

# Piston du compose, port 2000 sur l'hôte (lu seulement si EXECUTION_ENGINE=piston).
PISTON_URL=http://127.0.0.1:2000/api/v2

# Version de Node installée dans Piston : doit être exactement celle-ci (lu seulement si EXECUTION_ENGINE=piston).
PISTON_NODE_VERSION=20.11.1

# Monte /api/v1/admin. Jamais true sur un serveur public avant l'authentification.
ADMIN_API_ENABLED=true

# Niveau du journal : debug, info, warn, error.
LOG_LEVEL=debug

# Charge le contenu du dépôt si la base n'a aucun parcours (jamais en production).
SEED_ON_EMPTY=true

# Exécutions et vérifications autorisées par minute et par adresse IP.
EXECUTION_RATE_LIMIT=120

# Événements de statistiques autorisés par minute et par adresse IP.
EVENT_RATE_LIMIT=120
